  "web-ui": {
    "name": "web-ui",
    "description": "Web/UI build that cannot ship 'basic' UI/UX: a mandatory machine design-QA gate plus skill binding so the agent actually loads its design skills.",
    "status": "proposed",
    "roles": [
      {
        "id": "frontend",
        "mandate": "Implement the UI per locked contracts. Output must ship stylesheets, responsive breakpoints, a real type system, and semantic landmarks — the design-QA gate scores this and will FAIL basic output.",
        "output": "work/frontend/",
        "gate": "design"
      },
      {
        "id": "design-qa",
        "mandate": "Independently verify the UI is not 'basic': run the design checks, contrast spot-checks, and a11y signal audit against work/frontend/. Report numbers, not vibes.",
        "output": "work/design-qa/",
        "gate": "files"
      }
    ],
    "gates": [
      {
        "role": "frontend",
        "kind": "design",
        "min_score": 0.5,
        "required": [
          "manifest.json"
        ]
      },
      {
        "role": "design-qa",
        "kind": "files",
        "required": [
          "manifest.json"
        ]
      }
    ],
    "skills": [
      {
        "role": "frontend",
        "skill": "frontend-design"
      },
      {
        "role": "frontend",
        "skill": "ui-ux-pro-max"
      },
      {
        "role": "design-qa",
        "skill": "design-taste"
      }
    ],
    "cost": {
      "wall_clock_s": 7200,
      "credits": 40
    },
    "notes": "promoted 2026-10-24 by human approval (Hasan)",
    "build_policy": {
      "skills_proof": true,
      "skills_locations": [
        "/root/.agents/skills/",
        "~/.agents/skills/",
        "./.agents/skills/"
      ]
    }
  }
