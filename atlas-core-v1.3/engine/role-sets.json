      {
        "role": "verifier",
        "kind": "files",
        "required": [
          "manifest.json"
        ]
      },
      {
        "role": "synthesizer",
        "kind": "no-gate"
      }
    ],
    "cost": {
      "wall_clock_s": 3600,
      "credits": 80,
      "note": "research budget"
    }
  },
  "asset-management": {
    "name": "asset-management",
    "description": "Enterprise asset ledger MVP (fixed assets, depreciation, reports). Synthesized 2026-10-23 for pilot; pending human approval.",
    "roles": [
      {
        "id": "engineering",
        "mandate": "Implement the asset ledger app + CLI per locked contracts (PRD.md, ARCHITECTURE.md, schema.sql). Straight-line depreciation, status transitions, reports. All logic in a single importable module + thin CLI. No network, no secrets.",
        "output": "work/engineering/",
        "gate": "test"
      },
      {
        "id": "qa",
        "mandate": "Independently author and RUN a pytest suite against work/engineering/app.py. Tests cover every acceptance criterion in PRD.md section 2. Report actual exit codes; never predict results.",
        "output": "work/qa/",
        "gate": "test"
      },
      {
        "id": "domain-qa",
        "mandate": "Verify depreciation math: write verify_depreciation.py implementing the reference table in ARCHITECTURE.md section 4, then run it against work/engineering/app.py and report discrepancies verbatim.",
        "output": "work/domain-qa/",
        "gate": "shell"
      }
    ],
    "gates": [
      {
        "role": "engineering",
        "kind": "test",
        "commands": [
          "python3 -m pytest -q tests/ 2>/dev/null || python3 -m pytest -q"
        ],
        "required_note": "pytest must pass"
      },
      {
        "role": "qa",
        "kind": "test",
        "commands": [
          "python3 -m pytest -q"
        ]
      },
      {
        "role": "domain-qa",
        "kind": "shell",
        "commands": [
          "python3 verify_depreciation.py"
        ]
      }
    ],
    "status": "proposed",
    "cost": {
      "wall_clock_s": 3600,
      "credits": 60,
      "note": "asset ledger build budget"
    }
  },
