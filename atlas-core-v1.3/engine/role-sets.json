{
  "software": {
    "status": "active",
    "description": "Venture-parameterized software build. Roles scale with ask size — never a fixed 10.",
    "roles": [
      {
        "id": "pm",
        "mandate": "Author specs/contracts/PRD.md: scope, user stories, acceptance criteria, explicit non-goals. No feature creep; each story must be verifiable.",
        "output": "work/pm/",
        "gate": "files"
      },
      {
        "id": "arch",
        "mandate": "Author specs/contracts/ARCHITECTURE.md and schema.sql: data model, API surface, ADRs. Decisions must be testable and bounded.",
        "output": "work/arch/",
        "gate": "files"
      },
      {
        "id": "backend",
        "mandate": "Implement API + persistence per locked contracts. Deliver working code; every public function exercised by a test.",
        "output": "work/backend/",
        "gate": "test"
      },
      {
        "id": "client",
        "mandate": "Implement UI consuming the locked API. No inventing endpoints; if contract is insufficient, flag drift, do not edit specs/.",
        "output": "work/client/",
        "gate": "shell"
      },
      {
        "id": "qa",
        "mandate": "Independently author and RUN the test suite against produced code. Report actual exit codes and coverage, never predicted results.",
        "output": "work/qa/",
        "gate": "test"
      },
      {
        "id": "security",
        "mandate": "Run real scans (secret grep, dependency audit, auth review) and report tool output verbatim. No hardcoded verdicts.",
        "output": "work/security/",
        "gate": "shell"
      }
    ],
    "gates": [
      {
        "role": "pm",
        "kind": "files",
        "required": [
          "manifest.json"
        ]
      },
      {
        "role": "arch",
        "kind": "files",
        "required": [
          "manifest.json"
        ]
      },
      {
        "role": "backend",
        "kind": "test",
        "commands": [
          "python3 -m pytest -q"
        ]
      },
      {
        "role": "client",
        "kind": "shell",
        "human_fallback": true,
        "commands": [
          "bash -c \"if [ -f package.json ] && grep -q build package.json; then npm run build; else echo 'no build step declared — client gate UNVERIFIED'; exit 1; fi\""
        ]
      },
      {
        "role": "qa",
        "kind": "test",
        "commands": [
          "python3 -m pytest -q"
        ]
      },
      {
        "role": "security",
        "kind": "shell",
        "cwd": "run",
        "human_fallback": false,
        "commands": [
          "bash -c \"grep -rE 'sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}' . ../specs/ ; test $? -eq 1 || { echo 'secrets found — FAIL'; exit 1; }\""
        ]
      }
    ],
    "cost": {
      "wall_clock_s": 7200,
      "credits": 200,
      "note": "default software build budget"
    }
  },
  "design-studio": {
    "status": "active",
    "description": "Akar-style design engagements. Objective where checkable, UNVERIFIED otherwise.",
    "roles": [
      {
        "id": "creative-director",
        "mandate": "Define concept, visual language, and art direction brief. Output must name specific deliverables and acceptance tests.",
        "output": "work/creative-director/",
        "gate": "files"
      },
      {
        "id": "copywriter",
        "mandate": "Write brand copy per art direction brief. Every claim traceable to source material.",
        "output": "work/copywriter/",
        "gate": "no-gate"
      },
      {
        "id": "visual-qa",
        "mandate": "Check contrast ratios, asset specs, file deliverables. Run real tools; report numbers.",
        "output": "work/visual-qa/",
        "gate": "shell"
      }
    ],
    "gates": [
      {
        "role": "creative-director",
        "kind": "files",
        "required": [
          "manifest.json"
        ]
      },
      {
        "role": "copywriter",
        "kind": "no-gate"
      },
      {
        "role": "visual-qa",
        "kind": "shell",
        "commands": [
          "ls work/visual-qa/*.md | head -5"
        ]
      }
    ],
    "cost": {
      "wall_clock_s": 3600,
      "credits": 100,
      "note": "creative output budget"
    }
  },
